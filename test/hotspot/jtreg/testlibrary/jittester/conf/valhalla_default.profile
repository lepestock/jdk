# Valhalla default profile.
# Keep generation responsive while allowing value classes.
--identity-value-class-balance=80

# Keep plain generation responsive enough for smoke and pool preselection runs.
--classes-limit=6
--member-functions-limit=8
--data-member-limit=6
--statement-limit=18
--test-statement-limit=120
--operator-limit=35
--complexity-limit=1000000
--min-cfg-depth=2
--max-cfg-depth=3
